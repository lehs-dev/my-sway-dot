#!/bin/sh
set -eu

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=sway
export XDG_CURRENT_DESKTOP=sway
export MOZ_ENABLE_WAYLAND=1
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

flatpak_user="$HOME/.local/share/flatpak/exports/share"
flatpak_system="/var/lib/flatpak/exports/share"
if [ -n "${XDG_DATA_DIRS:-}" ]; then
    export XDG_DATA_DIRS="$flatpak_user:$flatpak_system:$XDG_DATA_DIRS"
else
    export XDG_DATA_DIRS="$flatpak_user:$flatpak_system:/usr/local/share:/usr/share"
fi

if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec sway "$@"
else
    exec dbus-run-session sway "$@"
fi
